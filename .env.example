APP_ENV=development
APP_NAME=LogiAI Platform
SERVER_PORT=8001
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://logiai:logiai@postgres:5432/logiai
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-before-exposing-this-service
CONNECTOR_SECRET_KEY=generate-a-fernet-key-and-keep-it-private
JWT_EXPIRE_MINUTES=1440
DEV_TENANT_CODE=demo
DEV_TENANT_NAME=演示租户
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@example.local
DEV_ADMIN_PASSWORD=123456
# LLM_PROVIDER: openai-compatible or anthropic-messages
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_INPUT_COST_PER_MILLION=0.8
LLM_OUTPUT_COST_PER_MILLION=2.7
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 备用大模型配置 (主模型/内网不可达或报错时自动降级无缝切换)
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FALLBACK_LLM_MODEL=qwen3.8-flash
FALLBACK_LLM_INPUT_COST_PER_MILLION=0.8
FALLBACK_LLM_OUTPUT_COST_PER_MILLION=2.7
